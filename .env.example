# PLAGIX Development Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git

# Database Configuration (PostgreSQL)
POSTGRES_USER=plagix_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=plagix_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL for application (used by SQLAlchemy)
# Inside Docker: use 'db' as host
DATABASE_URL=postgresql+psycopg://plagix_user:CHANGE_ME_IN_PRODUCTION@db:5432/plagix_db

# Database URL for host-side tools (Alembic, psql from Windows)
# Outside Docker: use 'localhost'
# DATABASE_URL_HOST=postgresql+psycopg://plagix_user:CHANGE_ME_IN_PRODUCTION@localhost:5432/plagix_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Application Configuration
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_IN_PRODUCTION
LOG_LEVEL=INFO

# Test Database (for pytest)
TEST_DATABASE_URL=postgresql+psycopg://plagix_user:CHANGE_ME_IN_PRODUCTION@db:5432/plagix_test_db
